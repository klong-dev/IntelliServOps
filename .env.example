# Environment Configuration
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/intellirentops?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PayOS Payment Gateway
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# Tuya IoT API
TUYA_ACCESS_ID=your-tuya-access-id
TUYA_ACCESS_SECRET=your-tuya-access-secret
TUYA_API_ENDPOINT=https://openapi.tuyaus.com

# Supabase Auth (for OTP via SMS)
SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_CHAT_IMAGES_BUCKET=chat-images

# FPT AI CCCD Verification
FPT_AI_ENABLED=true
FPT_AI_API_KEY=your-fpt-ai-api-key
FPT_AI_API_URL=https://api.fpt.ai/vision/idr/vnm/
FPT_AI_AUTO_VERIFY=true

# Application
APP_PORT=3000
APP_NAME=IntelliRentOps
API_PREFIX=api
API_VERSION=v1

# Swagger
SWAGGER_TITLE=IntelliRentOps API
SWAGGER_DESCRIPTION=Property Rental Management Platform API Documentation
SWAGGER_VERSION=1.0.0
