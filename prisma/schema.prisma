  automatic
  estimated
}

// --- Document Enums ---
enum PolicyType {
  rental_rules
  building_regulations
  pet_policy
  parking_rules
  noise_policy
  maintenance_policy
  security_policy
  common_area_usage
  cancellation_policy
  move_in_out_rules
}

enum DocumentType {
  contract_template
  addendum
  disclosure
  consent_form
  inspection_report
  other
}

// --- Notification Enums ---
enum NotificationType {
  info
  warning
  success
  error
  reminder
  promotion
}

enum NotificationChannel {
  in_app
  email
  sms
  push
  webhook
}

enum DeliveryStatus {
  pending
  sent
  delivered
  failed
  bounced
}

enum ActivityStatus {
  success
  failure
  pending
}

// ============================================================================
// ACTOR MODELS
// ============================================================================

model Guest {
  id                     String                 @id @default(uuid())
  email                  String                 @unique
  phone                  String?
  fullName               String?
  preferredContactMethod PreferredContactMethod @default(email)
  ipAddress              String?
  sessionToken           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  // Relations
  contactRequests  ContactRequest[]
  bookingRequests  BookingRequest[]
  appointments     Appointment[]

  @@index([sessionToken])
  @@map("guests")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  phone                    String?
  fullName                 String
  dateOfBirth              DateTime?
  profileImageUrl          String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  passwordHash             String?
  supabaseId               String?   @unique
  isActive                 Boolean   @default(true)
  isVerified               Boolean   @default(false)
  isPartner                Boolean   @default(false)
  lastLoginAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdByStaffId         String?

  // Partner business fields (nullable — only set for users who are also property owners)
  companyName              String?
  taxCode                  String?   @unique
  bankAccountNumber        String?
  bankName                 String?
  address                  String?
  commissionRate           Decimal?  @db.Decimal(5, 2)
  contractStartDate        DateTime?
  contractEndDate          DateTime?
  paymentTerms             String?

  // Relations
  createdByStaff        Staff?                @relation("UserCreatedByStaff", fields: [createdByStaffId], references: [id])
  identity              UserIdentity?
  contractMemberships   UserContractMember[]
  payments              Payment[]
  tickets               Ticket[]
  maintenanceRequests   MaintenanceRequest[]
  staffNotes            StaffNote[]
  userRooms             UserRoom[]
  userApartments        UserApartment[]
  reservations          Reservation[]
  apartmentRatings      ApartmentRating[]
  chatConversations     ChatConversation[]
  apartments            Apartment[]
  partnerRequests       PartnerRequest[]
  cooperationContracts  PartnerCooperationContract[] @relation("PartnerCooperationContractByPartner")
  partnerPayoutTransfers PartnerPayoutTransfer[]     @relation("PartnerPayoutTransferByPartner")

  @@index([phone])
  @@index([supabaseId])
  @@index([createdByStaffId])
  @@map("users")
}

// ─── User Identity (căn cước / hộ chiếu) ─────────────────────────────────

model UserIdentity {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  nationalId               String?   @unique  // Số căn cước công dân
  passportNumber           String?   @unique  // Hộ chiếu
  name                     String?              // Tên trên CCCD
  dob                      String?              // Ngày sinh
  sex                      String?              // Giới tính
  nationality              String?              // Quốc tịch
  ethnicity                String?              // Dân tộc
  home                     String?              // Nguyên quán
  address                  String?              // Địa chỉ đầy đủ
  province                 String?              // Tỉnh/Thành phố
  district                 String?              // Quận/Huyện
  ward                     String?              // Phường/Xã
  street                   String?              // Số nhà, đường
  features                 String?              // Đặc điểm nhận dạng
  issueDate                String?              // Ngày cấp
  doe                      String?              // Ngày hết hạn
  isVerified               Boolean   @default(false) // AI đã xác minh?
  verifiedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nationalId])
  @@index([isVerified])
  @@map("user_identities")
}

model Staff {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String
  fullName        String
  employeeCode    String    @unique
  role            StaffRole
  department      String?
  workingCity     String?
  workingDistrict String?
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  hireDate        DateTime
  passwordHash    String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  createdUsers               User[]                     @relation("UserCreatedByStaff")
  assignedTasks              Task[]                     @relation("TaskAssignedToStaff")
  appointments               Appointment[]
  contracts                  RentalContract[]           @relation("ContractCreatedByStaff")
  processedPayments          Payment[]                  @relation("PaymentProcessedByStaff")
  assignedTickets            Ticket[]                   @relation("TicketAssignedToStaff")
  utilityReadings            UtilityReading[]           @relation("ReadingByStaff")
  verifiedReadings           UtilityReading[]           @relation("ReadingVerifiedByStaff")
  pendingGuestRegistrations  PendingGuestRegistration[] @relation("PendingRegistrationByStaff")
  staffNotes                 StaffNote[]
  confirmedPartnerPayoutTransfers PartnerPayoutTransfer[] @relation("PartnerPayoutTransferConfirmedByStaff")

  @@index([role])
  @@index([isActive])
  @@map("staff")
}

model Operator {
  id           String        @id @default(uuid())
  email        String        @unique
  phone        String
  fullName     String
  employeeCode String        @unique
  shift        OperatorShift @default(flexible)
  passwordHash String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  contactRequests     ContactRequest[]  @relation("ContactRequestAssignedToOperator")
  assignedTasks       Task[]            @relation("TaskAssignedByOperator")
  approvedApartments  Apartment[]       @relation("ApartmentApprovedByOperator")
  approvedBookings    BookingRequest[]  @relation("BookingApprovedByOperator")
  approvedCooperationContracts PartnerCooperationContract[] @relation("PartnerCooperationContractApprovedByOperator")
  reviewedPartnerReqs PartnerRequest[]  @relation("PartnerRequestReviewedByOperator")

  @@index([shift])
  @@index([isActive])
  @@map("operators")
}

model Admin {
  id          String         @id @default(uuid())
  email       String         @unique
  phone       String?
  fullName    String
  username    String         @unique
  passwordHash String
  roleLevel   AdminRoleLevel @default(admin)
  permissions Json?
  lastLoginAt DateTime?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  createdPolicies   Policy[]        @relation("PolicyCreatedByAdmin")
  approvedPolicies  Policy[]        @relation("PolicyApprovedByAdmin")
  legalDocuments    LegalDocument[] @relation("DocumentCreatedByAdmin")

  @@index([roleLevel])
  @@index([isActive])
  @@map("admins")
}

// Partner and PartnerIdentity models have been merged into User and UserIdentity

// ============================================================================
// ASSET MODELS
// ============================================================================

model Apartment {
  id                    String           @id @default(uuid())
  buildingName          String?
  apartmentNumber       String
  maxConcurrentViewings Int              @default(2)
  floorNumber           Int?
  wardCode              Int?             // Mã phường/xã (v2)
  provinceCode          Int?             // Mã tỉnh/thành (v2), auto-resolved từ wardCode
  streetAddress         String?          // Địa chỉ cụ thể (số nhà, ngõ, hẻm, đường...)
  latitude              Decimal?         @db.Decimal(10, 8)
  longitude             Decimal?         @db.Decimal(11, 8)
  totalArea             Decimal          @db.Decimal(10, 2)
  usableArea            Decimal?         @db.Decimal(10, 2)
  numberOfBedrooms      Int              @default(0)
  numberOfBathrooms     Int              @default(0)
  furnishingStatus      FurnishingStatus @default(unfurnished)
  amenities             Json?            // Legacy column, replaced by apartmentAmenities relation
  baseRentPrice         Decimal          @db.Decimal(12, 2)
  depositAmount         Decimal?         @db.Decimal(12, 2)
  status                ApartmentStatus  @default(available)
  description           String?
  images                Json?
  videoTourUrl          String?
  yearBuilt             Int?
  ownerId               String?
  approvedByOperatorId  String?
  approvedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relations
  owner             User?              @relation(fields: [ownerId], references: [id])
  approvedByOperator Operator?          @relation("ApartmentApprovedByOperator", fields: [approvedByOperatorId], references: [id])
  rooms             Room[]
  rentalContracts   RentalContract[]
  iotDevices        IoTDevice[]
  utilityMeters     UtilityMeter[]
  contactRequests   ContactRequest[]
  bookingRequests   BookingRequest[]
  appointments      Appointment[]
  maintenanceReqs   MaintenanceRequest[]
  tasks             Task[]
  apartmentPolicies ApartmentPolicy[]
  apartmentAmenities ApartmentAmenity[]
  reservations      Reservation[]
  userApartments    UserApartment[]
  ratings           ApartmentRating[]
  cooperationContracts PartnerCooperationContract[]

  @@index([status])
  @@index([wardCode])
  @@index([provinceCode])
  @@index([ownerId])
  @@index([baseRentPrice])
  @@index([numberOfBedrooms])
  @@map("apartments")
}

model Amenity {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  description String?
  icon        String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  apartmentAmenities ApartmentAmenity[]

  @@index([isActive])
  @@index([name])
  @@map("amenities")
}

model ApartmentAmenity {
  apartmentId String
  amenityId   String
  createdAt   DateTime @default(now())

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  amenity   Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([apartmentId, amenityId])
  @@index([amenityId])
  @@map("apartment_amenities")
}

model PartnerCooperationContract {
  id                  String                           @id @default(uuid())
  contractNumber      String                           @unique
  apartmentId         String
  partnerId           String
  approvedByOperatorId String?
  startDate           DateTime
  endDate             DateTime
  commissionRate      Decimal                          @db.Decimal(5, 2)
  status              PartnerCooperationContractStatus @default(draft)
  signedAt            DateTime?
  contractDocumentUrl String?
  contractPdfData     Bytes?
  terms               String?
  notes               String?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  apartment           Apartment                        @relation(fields: [apartmentId], references: [id])
  partner             User                             @relation("PartnerCooperationContractByPartner", fields: [partnerId], references: [id])
  approvedByOperator  Operator?                        @relation("PartnerCooperationContractApprovedByOperator", fields: [approvedByOperatorId], references: [id])

  @@index([apartmentId])
  @@index([partnerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("partner_cooperation_contracts")
}

model PartnerPayoutTransfer {
  id                          String    @id @default(uuid())
  partnerId                   String
  periodMonth                 String
  periodStart                 DateTime
  periodEnd                   DateTime
  totalGrossAmount            Decimal   @db.Decimal(14, 2)
  totalSystemCommissionAmount Decimal   @db.Decimal(14, 2)
  totalNetPayoutAmount        Decimal   @db.Decimal(14, 2)
  transferProofImageUrl       String
  transferNote                String?
  confirmedByStaffId          String
  confirmedAt                 DateTime
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  partner                     User      @relation("PartnerPayoutTransferByPartner", fields: [partnerId], references: [id])
  confirmedByStaff            Staff     @relation("PartnerPayoutTransferConfirmedByStaff", fields: [confirmedByStaffId], references: [id])

  @@unique([partnerId, periodMonth])
  @@index([periodMonth])
  @@index([confirmedByStaffId])
  @@map("partner_payout_transfers")
}

model CooperationCommissionPhase {
  id             String    @id @default(uuid())
  phaseName      String
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  commissionRate Decimal   @db.Decimal(5, 2)
  isActive       Boolean   @default(true)
  createdByAdminId String?
  updatedByAdminId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("cooperation_commission_phases")
}

model ApartmentRating {
  id               String         @id @default(uuid())
  apartmentId      String
  userId           String
  rentalContractId String
  rating           Int
  comment          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  apartment      Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentalContract RentalContract @relation(fields: [rentalContractId], references: [id], onDelete: Cascade)

  @@unique([userId, apartmentId])
  @@index([apartmentId])
  @@index([userId])
  @@index([rentalContractId])
  @@map("apartment_ratings")
}
model Room {
  id                 String     @id @default(uuid())
  apartmentId        String
  roomNumber         String
  roomType           RoomType   @default(bedroom)
  area               Decimal?   @db.Decimal(10, 2)
  hasWindow          Boolean    @default(true)
  hasAirConditioning Boolean    @default(false)
  hasPrivateBathroom Boolean    @default(false)
  maxOccupancy       Int        @default(1)
  rentPrice          Decimal?   @db.Decimal(12, 2)
  status             RoomStatus @default(available)
  description        String?
  images             Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  apartment         Apartment            @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  iotDevices        IoTDevice[]
  maintenanceReqs   MaintenanceRequest[]
  userRooms         UserRoom[]

  @@unique([apartmentId, roomNumber])
  @@index([apartmentId])
  @@index([status])
  @@index([roomType])
  @@map("rooms")
}

// ============================================================================
// CONTRACT MODELS
// ============================================================================

model RentalContract {
  id                  String         @id @default(uuid())
  contractNumber      String         @unique
  apartmentId         String
  startDate           DateTime
  endDate             DateTime
  monthlyRent         Decimal        @db.Decimal(12, 2)
  depositAmount       Decimal        @db.Decimal(12, 2)
  paymentDueDay       Int            // 1-31
  paymentMethod       PaymentMethodType @default(bank_transfer)
  utilitiesIncluded   Json?
  utilitiesCharges    Json?
  contractTerms       String?
  specialConditions   String?
  landlordName        String?
  landlordIdNumber    String?
  landlordIdIssueDate String?
  landlordIdIssuePlace String?
  landlordAddress     String?
  landlordPhone       String?
  status              ContractStatus @default(draft)
  category            RentalContractCategory @default(normal)
  renewedFromContractId String?
  signedDate          DateTime?
  contractDocumentUrl String?
  contractPdfData     Bytes?              // Generated PDF document
  landlordSignature   Bytes?              // Landlord signature image
  tenantSignature     Bytes?              // Tenant signature image
  terminationDate     DateTime?
  terminationReason   String?
  earlyTerminationFee Decimal?       @db.Decimal(12, 2)
  createdByStaffId    String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  apartment           Apartment            @relation(fields: [apartmentId], references: [id])
  createdByStaff      Staff?               @relation("ContractCreatedByStaff", fields: [createdByStaffId], references: [id])
  renewedFromContract RentalContract?      @relation("RentalContractRenewals", fields: [renewedFromContractId], references: [id])
  renewalContracts    RentalContract[]     @relation("RentalContractRenewals")
  reservation         Reservation?
  members             UserContractMember[]
  invoices            Invoice[]
  tickets             Ticket[]
  maintenanceRequests MaintenanceRequest[]
  utilityReadings     UtilityReading[]
  userRooms           UserRoom[]
  userApartments      UserApartment[]
  apartmentRatings    ApartmentRating[]

  @@index([apartmentId])
  @@index([status])
  @@index([category])
  @@index([renewedFromContractId])
  @@index([startDate])
  @@index([endDate])
  @@map("rental_contracts")
}

model UserContractMember {
  id                  String       @id @default(uuid())
  userId              String
  rentalContractId    String
  memberType          MemberType   @default(co_tenant)
  isPrimaryContact    Boolean      @default(false)
  moveInDate          DateTime?
  moveOutDate         DateTime?
  notificationEnabled Boolean      @default(true)
  accessLevel         AccessLevel  @default(full)
  sharePercentage     Decimal?     @db.Decimal(5, 2)
  status              MemberStatus @default(active)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relations
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentalContract RentalContract @relation(fields: [rentalContractId], references: [id], onDelete: Cascade)

  @@unique([userId, rentalContractId])
  @@index([userId])
  @@index([rentalContractId])
  @@index([status])
  @@map("user_contract_members")
}

// ============================================================================
// REQUEST MODELS
// ============================================================================

model ContactRequest {
  id                     String               @id @default(uuid())
  guestId                String?
  apartmentId            String?
  fullName               String
  email                  String
  phone                  String
  preferredMoveInDate    DateTime?
  message                String?
  budgetRangeMin         Decimal?             @db.Decimal(12, 2)
  budgetRangeMax         Decimal?             @db.Decimal(12, 2)
  numberOfOccupants      Int?
  preferredContactMethod PreferredContactMethod @default(email)
  preferredContactTime   String?
  source                 ContactSource        @default(website)
  utmSource              String?
  utmCampaign            String?
  status                 ContactRequestStatus @default(new)
  assignedToOperatorId   String?
  receivedAt             DateTime             @default(now())
  firstContactedAt       DateTime?
  notes                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  // Relations
  guest              Guest?           @relation(fields: [guestId], references: [id])
  apartment          Apartment?       @relation(fields: [apartmentId], references: [id])
  assignedToOperator Operator?        @relation("ContactRequestAssignedToOperator", fields: [assignedToOperatorId], references: [id])
  bookingRequests    BookingRequest[]
  appointments       Appointment[]

  @@index([guestId])
  @@index([apartmentId])
  @@index([status])
  @@index([assignedToOperatorId])
  @@index([receivedAt])
  @@index([email])
  @@index([phone])
  @@map("contact_requests")
}

model BookingRequest {
  id                      String        @id @default(uuid())
  guestId                 String?
  apartmentId             String
  contactRequestId        String?
  desiredStartDate        DateTime
  desiredEndDate          DateTime
  numberOfOccupants       Int
  totalAmount             Decimal       @db.Decimal(12, 2)
  depositAmount           Decimal       @db.Decimal(12, 2)
  specialRequests         String?
  identificationDocuments Json?
  employmentVerification  Json?
  status                  BookingStatus @default(pending)
  rejectionReason         String?
  approvedByOperatorId    String?
  approvedAt              DateTime?
  createdRentalContractId String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Relations
  guest              Guest?          @relation(fields: [guestId], references: [id])
  apartment          Apartment       @relation(fields: [apartmentId], references: [id])
  contactRequest     ContactRequest? @relation(fields: [contactRequestId], references: [id])
