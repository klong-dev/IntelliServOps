  refundDate           DateTime?
  refundReason         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Relations
  invoice         Invoice @relation(fields: [invoiceId], references: [id])
  user            User    @relation(fields: [userId], references: [id])
  processedByStaff Staff?  @relation("PaymentProcessedByStaff", fields: [processedByStaffId], references: [id])

  @@index([invoiceId])
  @@index([userId])
  @@index([status])
  @@index([paymentDate])
  @@index([transactionId])
  @@map("payments")
}

