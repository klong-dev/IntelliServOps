// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

// --- Actor Enums ---
enum PreferredContactMethod {
  email
  phone
  both
  whatsapp
}

enum StaffRole {
  technician
  customer_service
  maintenance
  general
}

enum OperatorShift {
  morning
  afternoon
  night
  flexible
}

enum AdminRoleLevel {
  super_admin
  admin
  manager
}

enum ActorType {
  guest
  user
  staff
  operator
  admin
  system
}

// --- OTP & Registration Enums ---
enum OtpPurpose {
  registration
  password_reset
  phone_verification
}

enum PendingRegistrationStatus {
  pending
  otp_sent
  verified
  completed
  expired
  cancelled
}

// --- Asset Enums ---
enum FurnishingStatus {
  unfurnished
  semi_furnished
  fully_furnished
}

enum ApartmentStatus {
  available
  occupied
  maintenance
  reserved
  inactive
  verified
  pending
}

enum RoomType {
  bedroom
  living_room
  kitchen
  bathroom
  storage
  balcony
}

enum RoomStatus {
  available
  occupied
  maintenance
}

// --- Contract Enums ---
