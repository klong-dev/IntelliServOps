model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  rentalContractId   String
  invoiceType        InvoiceType   @default(rent)
  invoiceContent     Json?
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  issueDate          DateTime
  dueDate            DateTime
  baseRent           Decimal       @db.Decimal(12, 2)
  utilityCharges     Json?
  additionalCharges  Json?
  discounts          Json?
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  currency           String        @default("VND")
  status             InvoiceStatus @default(draft)
  paymentMethod      PaymentMethodType?
  invoiceDocumentUrl String?
  notes              String?
  sentAt             DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  rentalContract RentalContract @relation(fields: [rentalContractId], references: [id])
  payments       Payment[]

  @@index([rentalContractId])
  @@index([invoiceType])
  @@index([status])
  @@index([dueDate])
  @@index([billingPeriodStart])
  @@index([billingPeriodEnd])
  @@map("invoices")
}

model Payment {
  id                   String           @id @default(uuid())
  paymentReference     String           @unique
  invoiceId            String
  userId               String
