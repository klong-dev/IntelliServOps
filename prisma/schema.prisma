  approved
  rejected
  cancelled
  expired
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
  expired
}

enum AppointmentType {
  physical_viewing
  virtual_tour
  consultation
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum AppointmentOutcome {
  interested
  not_interested
  needs_followup
  booked
}

enum PartnerRequestStatus {
  submitted
  under_review
  approved
  rejected
  on_hold
}

enum PropertyType {
  apartment
  house
  condo
  studio
}

enum ContractType {
  exclusive
  non_exclusive
}

// --- Operations Enums ---
enum TaskType {
  followup
  maintenance
  inspection
  delivery
  cleaning
  general
}

enum Priority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  pending
  assigned
  in_progress
  completed
  cancelled
}

enum MaintenanceCategory {
  plumbing
  electrical
  hvac
  appliance
  structural
  pest_control
  other
}

enum Urgency {
  low
  medium
  high
  emergency
}

enum MaintenanceStatus {
  submitted
  acknowledged
  scheduled
  in_progress
  completed
  cancelled
}

enum CostCoverage {
  landlord
  tenant
  insurance
  warranty
}

enum TicketCategory {
  billing
  contract
  account
  complaint
  inquiry
  documentation
  other
}

enum TicketStatus {
  open
  in_progress
  waiting_for_user
  resolved
  closed
  escalated
}

enum RelatedEntityType {
  contact_request
  maintenance_request
  appointment
  inspection
}

// --- Financial Enums ---
enum InvoiceType {
  rent
  deposit
  contractDeposit
  utility
  service
  penalty
  other
}

enum InvoiceStatus {
  draft
  issued
  sent
  partially_paid
  paid
  overdue
  cancelled
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
  cancelled
