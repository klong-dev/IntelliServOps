  draft
  pending
  signed
  active
  expired
  terminated
  renewed
}

enum RentalContractCategory {
  normal
  renewal
}

enum PartnerCooperationContractStatus {
  draft
  pending
  signed
  active
  expired
  terminated
  cancelled
}

enum MemberType {
  primary
  co_tenant
  guarantor
}

enum AccessLevel {
  full
  limited
  view_only
}

enum MemberStatus {
  active
  moved_out
  inactive
}

enum UserRoomStatus {
  active
  moved_out
  inactive
}

enum UserApartmentStatus {
  active
  moved_out
  inactive
}

enum PaymentMethodType {
  bank_transfer
  cash
  e_wallet
  auto_debit
  credit_card
  debit_card
}

// --- Request Enums ---
enum ContactRequestStatus {
  new
  contacted
  scheduled
  converted
  lost
  spam
}

enum ContactSource {
  website
  mobile_app
  social_media
  referral
  walk_in
}

enum BookingStatus {
